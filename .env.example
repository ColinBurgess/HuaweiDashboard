APP_PORT=3001
MODBUS_HOST=192.168.1.140
MODBUS_PORTS=502,6607
MODBUS_HAS_BATTERY=false

# Telegram Bot Alerts (Optional)
# Create a bot with @BotFather on Telegram to get the token
# Instructions on how to get TELEGRAM_CHAT_ID are in the README
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# OCPP Server Configuration (for EV Charger)
OCPP_HOST=0.0.0.0
OCPP_PORT=9100
OCPP_PATH_PREFIX=/ocpp
OCPP_HEARTBEAT_INTERVAL=30

# Smart Charging Configuration
GREEN_GRID_VOLTAGE=230
GREEN_MAX_CHARGING_AMPS=32
GREEN_HYSTERESIS_WATTS=200
HYBRID_MIN_CHARGING_AMPS=7
HYBRID_START_MIN_CHARGING_AMPS=8

# Smart Charging Probe (for OCPP Charger Capabilities Detection)
OCPP_SMART_PROBE_ON_CONNECT=0
OCPP_SMART_PROBE_DELAY_MS=1500
OCPP_SMART_PROBE_STACK_LEVEL=2
OCPP_SMART_PROBE_CP_MAX_AMPS=8
OCPP_SMART_PROBE_TX_AMPS=10
OCPP_SMART_PROBE_CP_MAX_WATTS=2000
OCPP_SMART_PROBE_TX_WATTS=2300
OCPP_SMART_PROBE_RATE_UNIT=auto

# InfluxDB Configuration (Optional for statistics)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_ENABLED=false

# Service Mode (for Docker Compose modular deployment)
SERVICE_ROLE=monolith
START_MONOLITH=true
