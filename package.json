{
  "name": "huawei-dashboard",
  "description": "Modular home energy dashboard with Huawei inverter + car charger integration",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx backend/server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "service:inverter": "NODE_ENV=production SERVICE_ROLE=collector tsx backend/server.ts",
    "service:charger": "NODE_ENV=production SERVICE_ROLE=charger tsx backend/server.ts",
    "service:dashboard": "NODE_ENV=production SERVICE_ROLE=dashboard tsx backend/server.ts",
    "migrate:history": "tsx backend/scripts/migrate_history.ts",
    "version:show": "node -e \"console.log('HuaweiDashboard v' + require('./package.json').version)\"",
    "version:patch": "npm version patch --no-git-tag-version && npm run version:show",
    "version:minor": "npm version minor --no-git-tag-version && npm run version:show",
    "version:major": "npm version major --no-git-tag-version && npm run version:show"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@influxdata/influxdb-client": "^1.35.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.40.0",
    "jsmodbus": "^4.0.10",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
