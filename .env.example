APP_PORT=3001
MODBUS_HOST=192.168.1.140
MODBUS_PORTS=502,6607
MODBUS_HAS_BATTERY=false
MODBUS_POLLING_INTERVAL=1000

# Telegram Bot Alerts (Optional)
# Create a bot with @BotFather on Telegram to get the token
# Instructions on how to get TELEGRAM_CHAT_ID are in the README
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# OCPP Server Configuration (for EV Charger)
OCPP_HOST=0.0.0.0
OCPP_PORT=9100
OCPP_PATH_PREFIX=/ocpp
OCPP_HEARTBEAT_INTERVAL=30

# Smart Charging Configuration
GREEN_GRID_VOLTAGE=230
GREEN_MAX_CHARGING_AMPS=32
GREEN_HYSTERESIS_WATTS=200
HYBRID_MIN_CHARGING_AMPS=7
HYBRID_START_MIN_CHARGING_AMPS=8

# Smart Charging master switch.
# 1 = send SetChargingProfile / probe (dynamic power limiting for GREEN/HYBRID).
# 0 = original pre-refactor behaviour: only RemoteStartTransaction, charger uses its own default limit.
OCPP_SMART_CHARGING_ENABLED=1

# Debug OCPP API (troubleshooting only).
# 1 = expose POST /debug/ocpp on the OCPP port (9100) to forward arbitrary OCPP
#     calls to the connected charger (GetCompositeSchedule, TriggerMessage, etc.).
# 0 = disabled. Keep disabled in production: it grants full charger control.
OCPP_DEBUG_API=0

# Smart Charging Probe (for OCPP Charger Capabilities Detection)
OCPP_SMART_PROBE_ON_CONNECT=0
OCPP_SMART_PROBE_DELAY_MS=1500
OCPP_SMART_PROBE_STACK_LEVEL=2
OCPP_SMART_PROBE_CP_MAX_AMPS=8
OCPP_SMART_PROBE_TX_AMPS=10
OCPP_SMART_PROBE_CP_MAX_WATTS=2000
OCPP_SMART_PROBE_TX_WATTS=2300
OCPP_SMART_PROBE_RATE_UNIT=auto

# InfluxDB Configuration (Required for statistics and historical data)
# IMPORTANT: These values are generated/managed by setup-influxdb-v2.sh
#
# First setup: Run the script which will create the configuration
#   ./backend/scripts/setup-influxdb-v2.sh
#
# Password rotation: To rotate the admin password, run:
#   ./backend/scripts/setup-influxdb-v2.sh --rotate-password
#
# For local development, set INFLUX_PASSWORD before first run:
#   INFLUX_PASSWORD=your-secure-password
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_PASSWORD=
INFLUX_ORG=
INFLUX_BUCKET=

# Service Mode (for Docker Compose modular deployment)
SERVICE_ROLE=monolith
START_MONOLITH=true
